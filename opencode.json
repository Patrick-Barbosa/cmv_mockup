{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=firefox"
      ]
    }  
  }
}